  (f32set! buf (+ k 2) z)
  (f32set! buf (+ k 3) sx)
  (f32set! buf (+ k 4) sy)
  (f32set! buf (+ k 5) sz)
  (f32set! buf (+ k 6) yaw)
  (f32set! buf (+ k 7) p)
  (f32set! buf (+ k 8) roll)
  (f32set! buf (+ k 9) r)
  (f32set! buf (+ k 10) g)
  (f32set! buf (+ k 11) b))

