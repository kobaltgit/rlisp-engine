     (/ (f32vec-length *widx*) 3)
     (/ (f32vec-length *sky-idx*) 3)
     (* (length *trees*) (+ 10 21))
     (* 24 8)
     (* 9 4)
     (* 9 2)
     64))

;; ——— сцена ———
(define (draw-scene)
  (let* ((eye (list *cam-x*
                    (if *fly* *cam-y* (walk-eye-y))
                    *cam-z*))
         (look (list (+ *cam-x* (* 14.0 (cos *cam-a*)))
                     (if *fly* (+ *cam-y* (* 3.0 (sin 0.0))) (walk-eye-y))
                     (+ *cam-z* (* 14.0 (sin *cam-a*)))))
         (mvp (camera-mvp eye look 1.05))
         (fc (nth *pal* 2))
         (ld (sun-dir *tod*))
         (amb (nth *pal* 3))
         (dif (nth *pal* 4))
         (ldx (if *fly* (car ld) (car ld))))
    (gpu3d-clear (car fc) (cadr fc) (caddr fc))
    (gpu3d-view (car eye) (cadr eye) (caddr eye))
    ;; небо: без тумана, диффуз в ноль — купол и светила в чистых цветах
    (gpu3d-fog (car fc) (cadr fc) (caddr fc) 0.0)
    (gpu3d-light (car ld) (cadr ld) (caddr ld) amb 0.0)
    (gpu3d-mesh-vc *sky-pos* *sky-uv* *sky-vc* *sky-idx* (mat-identity) mvp 0)
    (draw-batch *orb-mesh* (orb-insts *tod*) mvp)
    ;; облака: mesh-vc, край каждого квадра растворён в цвет горизонта
    (cloud-vc!)
    (for-each (lambda (c)
                (gpu3d-mesh-vc *cloud-pos* *cloud-uv2* *cloud-vc* *cloud-idx*
                               (cloud-model c *t*) mvp 0))
              *clouds*)
    ;; ландшафт: туман и полное освещение
    (let ((fogc (pal-mix (nth *pal* 2) (car *pal*) 0.45)))
          (gpu3d-fog (car fogc) (cadr fogc) (caddr fogc) 0.010))
    (gpu3d-light (car ld) (cadr ld) (caddr ld) amb dif)
    (gpu3d-mesh-vc *tpos* *tuv* *tvc* *tidx* (mat-identity) mvp 0)
    ;; валуны
    (draw-batch *rock-mesh* *rock-insts* mvp)
    ;; лес: стволы и кроны только в видимой окрестности
    (draw-batch-v *pine-trunk* (trunk-insts *t* 'pine) mvp)
    (draw-batch-v *leaf-trunk* (trunk-insts *t* 'leaf) mvp)
    ;; кроны и трава — непрозрачные (без альфа-очереди)
    (draw-batch-v *pine-crown* (crown-insts *t*) mvp)
    (draw-batch-v *leaf-crown* (crown-insts *t*) mvp)
    (draw-batch-v *grass-mesh* (grass-insts *t*) mvp)
    ;; птицы
    (draw-batch-v *bird-mesh* (bird-insts *t*) mvp)
    ;; вода поверх суши
    (gpu3d-alpha-blend 0.78)
    (gpu3d-mesh-vc *wpos* *wuv* *wvc* *widx* (mat-identity) mvp 0)
    (gpu3d-alpha-blend 1.0)
    (gpu3d-flush-alpha)
    ;; пост: bloom + экспозиция/плечо + виньетка + зерно
    (gpu3d-post 1.08 0.55 0.30 0.030)
    mvp))

;; ——— HUD ———
(define (clock-str tod)
  (let* ((h (floor tod))
         (m (floor (* 60.0 (- tod h))))
         (hs (number->string h))
         (ms (number->string m)))
    (string-append (if (< h 10) (string-append "0" hs) hs)
                   ":"
                   (if (< m 10) (string-append "0" ms) ms))))
(define (draw-hud)
  (draw-text "DOLINA - STAGE 27" 6 5 1 (list 1 1 1))
  (draw-text (string-append "P " (number->string (floor *cam-x*)) ","
                            (number->string (floor *cam-z*)) " E "
                            (number->string (floor (if *fly* *cam-y* (walk-eye-y)))))
             6 29 1 (list 0.6 0.8 0.9))
  (draw-text (string-append "T " (clock-str *tod*)
                            "  FPS " (number->string *fps-val*)
                            "  TRIS " (number->string
                                       (+ *tris-static* (* *grass-vis-n* 8))))
             6 13 1 (list 0.75 0.88 0.62))
  (draw-text "W/S MOVE  A/D TURN  Q/E STRAFE  F FLY T/G UP/DN  R +2H"
             6 21 1 (list 0.85 0.85 0.7)))

(define (draw)
  (draw-scene)
  ;; HUD раз в 12 кадров: draw-text — сотни env-аллокаций, главный GC-донор
  (if (= 0 (mod *frame* 12))
      (draw-hud)
      #f)
  (gpu-present))

(define (update dt)
  (set! *t* (+ *t* dt))
  (set! *frame* (+ *frame* 1))
  (set! *tod* (mod (+ *tod* (* dt 0.1)) 24.0))     ; сутки — 4 минуты
  (if (key-pressed? "r") (set! *tod* (mod (+ *tod* 2.0) 24.0)) #f)
  (if (key-pressed? "f")
      (begin
        (set! *fly* (not *fly*))
        (if *fly* (set! *cam-y* (walk-eye-y)) #f))
      #f)
  (set! *pal* (tod-pal *tod*))
  (if (key-down? "a") (set! *cam-a* (+ *cam-a* (* 1.7 dt))) #f)
  (if (key-down? "d") (set! *cam-a* (- *cam-a* (* 1.7 dt))) #f)
  (let ((sp (* dt (if *fly* 15.0 6.4)))
        (dx (cos *cam-a*)) (dz (sin *cam-a*)))
    (if (key-down? "w")
        (begin (set! *cam-x* (+ *cam-x* (* dx sp)))
               (set! *cam-z* (+ *cam-z* (* dz sp))))
        #f)
    (if (key-down? "s")
        (begin (set! *cam-x* (- *cam-x* (* dx sp)))
               (set! *cam-z* (- *cam-z* (* dz sp))))
        #f)
    (if (key-down? "q")
        (begin (set! *cam-x* (+ *cam-x* (* dz sp)))
               (set! *cam-z* (- *cam-z* (* dx sp))))
        #f)
    (if (key-down? "e")
        (begin (set! *cam-x* (- *cam-x* (* dz sp)))
               (set! *cam-z* (+ *cam-z* (* dx sp))))
        #f)
    (if *fly*
        (begin
          (if (key-down? "t") (set! *cam-y* (+ *cam-y* (* 9.0 dt))) #f)
          (if (key-down? "g") (set! *cam-y* (max 1.2 (- *cam-y* (* 9.0 dt)))) #f))
        #f))
  (set! *cam-x* (max -108.0 (min 108.0 *cam-x*)))
  (set! *cam-z* (max -108.0 (min 108.0 *cam-z*)))
  (if (= 0 (mod *frame* 8)) (update-visible!) #f)
  (sky-vc! *t*)
  (water-vc! *t*)
  (if (= 0 (mod *frame* 3)) (update-water! *t*) #f)
  (if (>= *frame* (+ *fps-last* 120))
      (begin
        (set! *fps-val* (/ 120.0 (max 0.001 (- (time-now) *fps-clock*))))
        (set! *fps-clock* (time-now))
        (set! *fps-last* *frame*))
      #f)
  #t)

(define *fps-clock* (time-now))
(update-visible!)
(print (string-append
        "DOLINA: ландшафт "
        (number->string (+ (* (+ *ln* 1) (+ *ln* 1)) 0))
        " верш, деревьев "
        (number->string (length *trees*))
        ", травы "
        (number->string (length *field*))
        "; сутки 4 мин; A/D поворот W/S ходьба R +2ч"))
