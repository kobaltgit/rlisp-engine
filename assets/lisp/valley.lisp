    (define (field-go fs acc)
      (if (null? fs)
          (begin (set! *grass-vis* (reverse acc))
                 (set! *grass-vis-n* (length *grass-vis*)))
          (let ((g (car fs)))
            (field-go (cdr fs)
                      (if (near? (car g) (caddr g) 625.0)
                          (cons g acc)
                          acc)))))
