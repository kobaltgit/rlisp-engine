;; конус: кольцо + вершина (без дна)
(define (cone-into pos-ref idx-ref vi r h y0 seg)
  ;; хвостовая рекурсия неудобна с мутацией списков — строим явно
  (let ((ring '()) (idx '()))
    (dotimes (j seg)
      (let ((a (* 6.28318 (/ j seg))))
        (set! ring (append ring (list (* r (cos a)) y0 (* r (sin a)))))))
    (set! idx (list vi))
    (list ring idx)))
;; проще: функции, возвращающие (pos idx), склейка вручную
(define (cone-mesh r h seg)
  (let ((pos '()) (idx '()))
    (dotimes (j seg)
      (let ((a (* 6.28318 (/ j seg))))
        (set! pos (append pos (list (* r (cos a)) 0.0 (* r (sin a)))))))
    (set! pos (append pos (list 0.0 h 0.0)))
    (dotimes (j seg)
      (let ((j1 (mod (+ j 1) seg)))
        (set! idx (append idx (list j j1 seg)))))
    (list pos idx)))
(define (pine-crown-mesh)
  ;; три конуса юнит-высоты: склейка со сдвигом вершин по y
  (let* ((c0 (cone-mesh 1.0 0.45 6))
         (c1 (cone-mesh 0.78 0.50 6))
         (c2 (cone-mesh 0.55 0.45 6))
         (pos (car c0)) (idx (cadr c0)) (n0 (/ (length (car c0)) 3)))
    (define (add-cone c yoff)
      (let* ((cp (car c)) (ci (cadr c)) (n (/ (length cp) 3)))
        (dotimes (v n)
          (set! pos (append pos (list (nth cp (* v 3))
                                      (+ (nth cp (+ (* v 3) 1)) yoff)
                                      (nth cp (+ (* v 3) 2))))))
        (dotimes (t (length ci))
          (set! idx (append idx (list (+ n0 (nth ci t))))))
        (set! n0 (+ n0 n))))
    (add-cone c1 0.30)
    (add-cone c2 0.62)
    (list (f32-from-list pos) (f32-from-list idx))))
