;; valley.lisp — «ДОЛИНА» (этап 27): большой открытый ландшафт с графоном.
;; Квадрат ±115 при 64×64 клетках: холмы на fbm-шуме, котлован озера с пляжем,
;; горный обод со снежными вершинами; вода с волнами/глиттером/пеной у берега;
;; небодом с динамической палитрой (день-ночь), звёзды в куполе, солнце/луна,
;; текстурные облака; лес (сосны/лиственные) с покачиванием крон на ветру,
;; трава и цветы с дистанционной выбраковкой, валуны, стая птиц.
;; Управление: A/D — поворот, W/S — ходьба, Q/E — стрейф, F — полёт
;; (T/G — вверх/вниз), R — +2 часа к времени суток.
;; Вся сцена — Lisp над нативами gpu3d-*/f32vec-*: без текстурных файлов,
;; работает и в wasm-песочнице.

(defpersistent *t* 0.0)
(defpersistent *frame* 0)
(defpersistent *fps-last* 0)
(defpersistent *fps-val* 0.0)
(defpersistent *cam-a* -0.93)
(defpersistent *fly* #f)
(defpersistent *cam-y* 0.0)

;; ——— шум: value-noise с smoothstep + fbm ———
(define (hash2 x y)
  (abs (sin (+ (* x 12.9898) (* y 78.233)))))
;; равномерный [0..1): два независимых иррациональных шага — hash2(i,k)
;; при целом i ложит точки на кривую Лиссажу (найдено: у спавна пусто,
;; лес «весь позади»), а это заполняет плоскость честно
(define (u01 i k)
  (let ((v (* (+ i 0.5) (+ 0.61803399 (* 0.37 k)))))
    (- v (floor v))))
(define (vnoise x z)
  (let* ((xi (floor x)) (zi (floor z))
         (xf (- x xi)) (zf (- z zi))
         (u (* xf xf (- 3.0 (* 2.0 xf))))
         (w (* zf zf (- 3.0 (* 2.0 zf))))
         (a (hash2 xi zi)) (b (hash2 (+ xi 1.0) zi))
         (c (hash2 xi (+ zi 1.0))) (d (hash2 (+ xi 1.0) (+ zi 1.0))))
    (+ (* a (- 1.0 u) (- 1.0 w))
       (* b u (- 1.0 w))
       (* c (- 1.0 u) w)
       (* d u w))))
(define (fbm x z oct)
  (define (go k f amp acc)
    (if (>= k oct)
        acc
        (go (+ k 1) (* f 2.03) (* amp 0.5)
            (+ acc (* amp (vnoise (* x f) (* z f)))))))
  (go 0 1.0 1.0 0.0))

;; ——— высоты: холмы + котлован озера + горный обод ———
(define *la* 115.0)
(define *ln* 46)
(define *lake-x* 30.0)
(define *lake-z* -28.0)
(define (valley-h x z)
  (let* ((r (sqrt (+ (* x x) (* z z))))
         (h1 (- (* 3.6 (fbm (+ (* x 0.045) 40.0) (+ (* z 0.045) 40.0) 4)) 1.3))
         (dl (sqrt (+ (* (- x *lake-x*) (- x *lake-x*))
                      (* (- z *lake-z*) (- z *lake-z*)))))
         (dep (* 7.5 (max 0.0 (- 1.0 (/ dl 30.0)))))
         (rk (max 0.0 (/ (- r 60.0) 52.0)))
         (rim (* rk rk rk (+ 11.0 (* 6.0 (fbm (+ x 7.0) (+ z 7.0) 3)))))
         (wig (* 0.35 (vnoise (+ (* x 0.11) 91.0) (+ (* z 0.11) 17.0)))))
    (+ h1 (- dep) rim wig)))
(define (valley-slope x z)
  (let ((h (valley-h x z)))
    (min 1.0 (/ (+ (abs (- (valley-h (+ x 1.1) z) h))
                   (abs (- (valley-h x (+ z 1.1)) h))) 2.2))))

;; ——— сетка рельефа (позиции 3/верш, uv 2/верш, индексы) ———
(define (v-grid a n hfn)
  (let ((v (make-f32vec (* (+ n 1) (+ n 1) 3) 0.0))
        (uv (make-f32vec (* (+ n 1) (+ n 1) 2) 0.0))
        (idx '()))
    (define (vx i) (- (* 2 a (/ i n)) a))
    (define (vz j) (- (* 2 a (/ j n)) a))
    (define (vi i j) (+ (* i (+ n 1)) j))
    (define (go-cols i j)
      (if (>= j n) #f
          (begin
            (set! idx (append idx (list (vi i j) (vi i (+ j 1)) (vi (+ i 1) (+ j 1))
                                        (vi i j) (vi (+ i 1) (+ j 1)) (vi (+ i 1) j))))
            (go-cols i (+ j 1)))))
    (define (go-rows i)
      (if (>= i n) #f (begin (go-cols i 0) (go-rows (+ i 1)))))
    (dotimes (i (+ n 1))
      (dotimes (j (+ n 1))
        (let ((k (* (+ (* i (+ n 1)) j) 3))
              (u (* (+ (* i (+ n 1)) j) 2)))
          (f32set! v k (vx i))
          (f32set! v (+ k 1) (hfn (vx i) (vz j)))
          (f32set! v (+ k 2) (vz j))
          (f32set! uv u (/ i n))
          (f32set! uv (+ u 1) (/ j n)))))
    (go-rows 0)
    (list v uv (f32-from-list idx))))

(define *terrain* (v-grid *la* *ln* valley-h))
(define *tpos* (car *terrain*))
(define *tidx* (caddr *terrain*))
(define *tuv* (cadr *terrain*))
(define *t-n* (* (+ *ln* 1) (+ *ln* 1)))

;; ——— цвет вершины по высоте/крутизне: дно→пляж→луг→хвойник→камень→снег ———
(define (lerp3 a b k)
  (list (+ (* (car a) (- 1.0 k)) (* (car b) k))
        (+ (* (cadr a) (- 1.0 k)) (* (cadr b) k))
        (+ (* (caddr a) (- 1.0 k)) (* (caddr b) k))))
(define (band h c0 c1 lo hi)
  (lerp3 c0 c1 (min 1.0 (max 0.0 (/ (- h lo) (- hi lo))))))
(define (make-terrain-vc)
  (let ((vc (make-f32vec (* *t-n* 4) 1.0)))
    (dotimes (i *t-n*)
      (let* ((x (f32ref *tpos* (* i 3)))
             (z (f32ref *tpos* (+ (* i 3) 2)))
             (h (f32ref *tpos* (+ (* i 3) 1)))
             (sl (valley-slope x z))
             (nz (vnoise (+ (* x 0.5) 3.0) (+ (* z 0.5) 77.0)))
             (c (cond ((< h -0.35) (band h (list 0.30 0.33 0.20) (list 0.42 0.44 0.28) -4.0 -0.35))
                      ((< h 0.55) (band h (list 0.83 0.75 0.53) (list 0.76 0.68 0.46) -0.35 0.55))
                      ((< h 3.6) (lerp3 (list 0.40 0.56 0.26) (list 0.33 0.49 0.23) nz))
                      ((< h 8.5) (lerp3 (list 0.33 0.47 0.23) (list 0.29 0.42 0.22) nz))
                      (else (lerp3 (list 0.34 0.32 0.29) (list 0.42 0.40 0.37) nz))))
             ;; скалы по крутизне перекрывают траву
             (c (if (> sl 0.42) (lerp3 c (lerp3 (list 0.36 0.34 0.31) (list 0.46 0.44 0.41) nz)
                                        (min 1.0 (/ (- sl 0.42) 0.25))) c))
             ;; снег на вершинах (по высоте) — скалы его держат
             (c (if (> h 14.8) (lerp3 c (list 0.90 0.93 0.97)
                                      (min 1.0 (/ (- h 14.8) 2.6))) c))
             (sh (* 0.82 (+ 0.24 (- 1.0 (* 0.42 sl)))))
             ;; запечённое «солнце с юго-запада»: склон к свету светлее
             (hb (valley-h (- x 1.4) (+ z 1.4)))
             (sunb (max -0.6 (min 0.6 (* (- hb h) 0.45))))
             (mt (* 0.90 (+ 0.92 (* 0.30 nz)))))
        (f32set! vc (* i 4)       (* (car c)   (+ 0.78 (* 0.22 sh) sunb) mt))
        (f32set! vc (+ (* i 4) 1) (* (cadr c)  (+ 0.78 (* 0.22 sh) sunb) mt))
        (f32set! vc (+ (* i 4) 2) (* (caddr c) (+ 0.78 (* 0.22 sh) sunb) mt))
        (f32set! vc (+ (* i 4) 3) 1.0)))
    vc))
(define *tvc* (make-terrain-vc))

;; ——— вода: сетка на котловане, цвет по глубине + пена у берега ———
(define *wn* 18)
(define *wa* 31.0)
(define (lake-h x z) (valley-h (+ x *lake-x*) (+ z *lake-z*)))
(define *water* (v-grid *wa* *wn* (lambda (x z) 0.0)))
(define *wpos* (car *water*))
(define *widx* (caddr *water*))
(define *wuv* (cadr *water*))
(define *w-n* (* (+ *wn* 1) (+ *wn* 1)))
;; вода стоит на y=0 и сдвигается к котловану одним инстанс-столбцом? —
;; проще: сдвигаем позиции сетки при построении (v-grid по центру мира,
;; значит сдвигаем уже после): x += lake-x, z += lake-z
(define (shift-grid! pos dx dz)
  (dotimes (i *w-n*)
    (f32set! pos (* i 3) (+ (f32ref pos (* i 3)) dx))
    (f32set! pos (+ (* i 3) 2) (+ (f32ref pos (+ (* i 3) 2)) dz))))
(shift-grid! *wpos* *lake-x* *lake-z*)
(define (make-water-vc)
  (let ((vc (make-f32vec (* *w-n* 4) 1.0)))
    (dotimes (i *w-n*)
      (let* ((x (f32ref *wpos* (* i 3)))
             (z (f32ref *wpos* (+ (* i 3) 2)))
             (d (min 2.4 (max 0.0 (- 0.0 (valley-h x z)))))
             (k (/ d 2.4))
             ;; пена: мелко у берега — светлее и плотнее
             (foam (max 0.0 (- 1.0 (/ d 0.30)))))
        (f32set! vc (* i 4)       (+ (* 0.42 (- 1.0 k)) (* 0.16 k) (* 0.35 foam)))
        (f32set! vc (+ (* i 4) 1) (+ (* 0.72 (- 1.0 k)) (* 0.46 k) (* 0.38 foam)))
        (f32set! vc (+ (* i 4) 2) (+ (* 0.78 (- 1.0 k)) (* 0.72 k) (* 0.32 foam)))
        (f32set! vc (+ (* i 4) 3) (+ 0.42 (* 0.26 k) (* 0.28 foam)))))
    vc))
(define *wvc* (make-water-vc))
;; глиттер: базы/фазы предвычислены (depth-часть статична)
(define *wbase-r* (make-f32vec *w-n* 0.0))
(define *wbase-g* (make-f32vec *w-n* 0.0))
(define *wbase-b* (make-f32vec *w-n* 0.0))
(define *wbase-a* (make-f32vec *w-n* 0.0))
(define *wgl-k* (make-f32vec *w-n* 0.0))
(define *wph1* (make-f32vec *w-n* 0.0))
(define *wph2* (make-f32vec *w-n* 0.0))
(define (water-precomp!)
  (dotimes (i *w-n*)
    (let* ((x (f32ref *wpos* (* i 3)))
           (z (f32ref *wpos* (+ (* i 3) 2)))
           (d (min 2.4 (max 0.0 (- 0.0 (valley-h x z)))))
           (k (/ d 2.4))
           (foam (max 0.0 (- 1.0 (/ d 0.30)))))
      (f32set! *wbase-r* i (+ (* 0.42 (- 1.0 k)) (* 0.16 k) (* 0.35 foam)))
      (f32set! *wbase-g* i (+ (* 0.72 (- 1.0 k)) (* 0.46 k) (* 0.38 foam)))
      (f32set! *wbase-b* i (+ (* 0.78 (- 1.0 k)) (* 0.72 k) (* 0.32 foam)))
      (f32set! *wbase-a* i (+ 0.42 (* 0.26 k) (* 0.28 foam)))
      (f32set! *wgl-k* i (+ 0.30 (* 0.70 (- 1.0 k))))
      (f32set! *wph1* i (* x 2.1))
      (f32set! *wph2* i (+ (* z 1.7) x)))))
(water-precomp!)
;; глиттер на векторных нативах: sin(ph1+2t)·sin(ph2+1.5t) → ^6 → цвет
;; (sp^6 = 3 векторных умножения: ^2, ^4, ^8… берём ^6 как ^2·^4)
(define *wv-s1* (make-f32vec *w-n* 0.0))
(define *wv-s2* (make-f32vec *w-n* 0.0))
(define *wv-sp* (make-f32vec *w-n* 0.0))
(define *wv-gl* (make-f32vec *w-n* 0.0))
(define (water-vc! t)
  (f32vec-op! *wv-s1* '+ *wph1* (* 2.0 t))
  (f32vec-op! *wv-s1* 'sin *wv-s1*)
  (f32vec-op! *wv-s2* '+ *wph2* (* 1.5 t))
  (f32vec-op! *wv-s2* 'sin *wv-s2*)
  (f32vec-op! *wv-sp* '* *wv-s1* *wv-s2*)
  (f32vec-op! *wv-gl* '* *wv-sp* *wv-sp*)          ; ^2
  (f32vec-op! *wv-gl* '* *wv-gl* *wv-gl*)          ; ^4
  (f32vec-op! *wv-sp* '* *wv-sp* *wv-gl*)          ; ^6
  (f32vec-op! *wv-gl* '* *wv-sp* *wgl-k*)          ; ^6·k
  (f32vec-op! *wv-gl* '* *wv-gl* 0.14)
  ;; rgb = base + gl (+0.02 к r), alpha = base-a
  (f32vec-op! *wv-s1* '+ *wbase-r* *wv-gl*)
  (f32vec-op! *wv-s2* '+ *wbase-g* *wv-gl*)
  (f32vec-op! *wv-sp* '+ *wbase-b* *wv-gl*)
  (f32vec-strided-set! *wvc* 4 0 *wv-s1*)
  (f32vec-strided-set! *wvc* 4 1 *wv-s2*)
  (f32vec-strided-set! *wvc* 4 2 *wv-sp*)
  (f32vec-strided-set! *wvc* 4 3 *wbase-a*))
;; волны вершин (ALU): y = 0.13·sin(1.1x+2.0t) + 0.10·cos(0.9z+1.5t)
(define *wp1* (make-f32vec *w-n* 0.0))
(define *wp2* (make-f32vec *w-n* 0.0))
(define *wtmp-a* (make-f32vec *w-n* 0.0))
(define *wtmp-b* (make-f32vec *w-n* 0.0))
(define *wtmp-c* (make-f32vec *w-n* 0.0))
(dotimes (i *w-n*)
  (f32set! *wp1* i (* 1.1 (f32ref *wpos* (* i 3))))
  (f32set! *wp2* i (* 0.9 (f32ref *wpos* (+ (* i 3) 2)))))
(define (update-water! t)
  (f32vec-op! *wtmp-a* '+ *wp1* (* 2.0 t))
  (f32vec-op! *wtmp-a* 'sin *wtmp-a*)
  (f32vec-op! *wtmp-a* '* *wtmp-a* 0.13)
  (f32vec-op! *wtmp-b* '+ *wp2* (* 1.5 t))
  (f32vec-op! *wtmp-b* 'cos *wtmp-b*)
  (f32vec-op! *wtmp-b* '* *wtmp-b* 0.10)
  (f32vec-op! *wtmp-c* '+ *wtmp-a* *wtmp-b*)
  (f32vec-strided-set! *wpos* 3 1 *wtmp-c*))

;; ——— небодом: геометрия статична, ЦВЕТА пересчитываются каждый кадр ———
;; 7 колец × 17 колонок = 119 вершин купола + 24 звезды (72 вершины).
(define (skydome-mesh)
  (let ((pos '()) (idx '()) (vi 0))
    (define (go i)
      (if (>= i 7)
          #f
          (let ((phi (* 3.14159 (/ i 6.5))))
            (dotimes (j 17)
              (let* ((th (* 6.28318 (/ j 16)))
                     (y (max -0.14 (cos phi)))
                     (rr (sin phi)))
                (set! pos (append pos (list (* 335 rr (cos th))
                                            (* 335 y)
                                            (* 335 rr (sin th)))))))
            (if (< i 6)
                (dotimes (j 16)
                  (let ((a (+ vi j)) (b (+ vi j 1)) (c (+ vi 17 j)) (d (+ vi 17 j 1)))
                    (set! idx (append idx (list a c b  b c d)))))
                #f)
            (set! vi (+ vi 17))
            (go (+ i 1)))))
    (go 0)
    ;; звёзды: маленькие треугольники на верхней полусфере
    (dotimes (s 42)
      (let* ((ea (+ 0.34 (* 0.075 (mod s 6))))       ; высота над горизонтом
             (az (* 0.30 s))
             (cx (* 330 (cos ea) (cos az)))
             (cy (* 330 (sin ea)))
             (cz (* 330 (cos ea) (sin az)))
             (sz (* 11.0 (+ 0.5 (u01 s 1.7)))))
        (set! pos (append pos (list cx (+ cy sz) cz
                                    (- cx (* sz 0.9)) cy cz
                                    cx (- cy (* sz 0.5)) (+ cz sz)))))
      (let ((v (+ vi (* s 3))))
        (set! idx (append idx (list v (+ v 1) (+ v 2)
                                    (+ v 2) (+ v 1) v)))))
    (list (f32-from-list pos) (f32-from-list idx))))
(define *sky-pos* (car (skydome-mesh)))
(define *sky-idx* (cadr (skydome-mesh)))
(define *sky-vc* (make-f32vec (* 245 4) 1.0))
(define *sky-uv* (make-f32vec (* 245 2) 0.0))
;; k-фактор купола: 0 у зенита → 1 у горизонта (для градиента)
(define *sky-k* (make-f32vec 119 0.0))
(dotimes (i 119)
  (let* ((y (f32ref *sky-pos* (+ (* i 3) 1)))
         (k (sqrt (max 0.0 (min 1.0 (/ (- 0.06 (/ y 335.0)) 0.98))))))
    (f32set! *sky-k* i k)))
(define *star-k* 0.0)   ; заполнится палитрой

;; ——— палитра суток: (час zen hor fog amb diff cloud star) ———
(define (c3 r g b) (list r g b))
(define *pal-stops*
  (list (list 0.0  (c3 0.02 0.04 0.09) (c3 0.05 0.07 0.13) (c3 0.04 0.06 0.11) 0.24 0.26 (c3 0.09 0.11 0.17) 1.0)
        (list 4.6  (c3 0.05 0.07 0.14) (c3 0.14 0.11 0.16) (c3 0.12 0.10 0.14) 0.32 0.34 (c3 0.18 0.16 0.22) 1.0)
        (list 6.3  (c3 0.26 0.32 0.52) (c3 0.94 0.54 0.30) (c3 0.72 0.50 0.38) 0.44 0.60 (c3 1.00 0.72 0.52) 0.05)
        (list 8.5  (c3 0.30 0.52 0.85) (c3 0.72 0.82 0.92) (c3 0.70 0.80 0.90) 0.52 0.80 (c3 1.00 1.00 1.00) 0.0)
        (list 14.0 (c3 0.26 0.50 0.90) (c3 0.70 0.82 0.94) (c3 0.68 0.80 0.92) 0.56 0.86 (c3 1.00 1.00 1.00) 0.0)
        (list 18.3 (c3 0.28 0.36 0.60) (c3 1.00 0.52 0.22) (c3 0.85 0.50 0.30) 0.42 0.60 (c3 1.00 0.70 0.40) 0.0)
        (list 19.8 (c3 0.13 0.16 0.34) (c3 0.90 0.36 0.20) (c3 0.62 0.32 0.26) 0.36 0.44 (c3 0.78 0.42 0.38) 0.15)
        (list 21.3 (c3 0.06 0.08 0.16) (c3 0.20 0.13 0.17) (c3 0.13 0.11 0.15) 0.31 0.34 (c3 0.15 0.14 0.20) 0.75)
        (list 24.0 (c3 0.03 0.05 0.10) (c3 0.06 0.08 0.14) (c3 0.05 0.07 0.12) 0.30 0.32 (c3 0.10 0.12 0.18) 1.0)))
(define (pal-mix a b k)
  (list (+ (* (car a) (- 1.0 k)) (* (car b) k))
        (+ (* (cadr a) (- 1.0 k)) (* (cadr b) k))
        (+ (* (caddr a) (- 1.0 k)) (* (caddr b) k))))
(define (tod-pal tod)
  (define (go stops)
    (let ((a (car stops)) (b (cadr stops)))
      (if (<= tod (car b))
          (let ((k (/ (- tod (car a)) (max 0.001 (- (car b) (car a))))))
            (list (pal-mix (cadr a) (cadr b) k)
                  (pal-mix (caddr a) (caddr b) k)
                  (pal-mix (cadddr a) (cadddr b) k)
                  (+ (* (nth a 4) (- 1.0 k)) (* (nth b 4) k))
                  (+ (* (nth a 5) (- 1.0 k)) (* (nth b 5) k))
                  (pal-mix (nth a 6) (nth b 6) k)
                  (+ (* (nth a 7) (- 1.0 k)) (* (nth b 7) k))))
          (go (cdr stops)))))
  (go *pal-stops*))
(define *pal* (tod-pal 12.0))   ; обновляется каждый кадр в update

;; ——— солнце/луна: сферы на куполе, позиция и цвет из времени суток ———
(define (psphere-mesh nring nseg)
  (let ((pos '()) (idx '()) (vi 0))
    (dotimes (i (+ nring 1))
      (dotimes (j nseg)
        (let* ((ph (* 3.14159 (/ i nring)))
               (th (* 6.28318 (/ j nseg)))
               (y (cos ph)))
          (set! pos (append pos (list (* (sin ph) (cos th)) y (* (sin ph) (sin th))))))))
    (define (vi2 i j) (+ (* i nseg) (mod j nseg)))
    (dotimes (i nring)
      (dotimes (j nseg)
        (set! idx (append idx (list (vi2 i j) (vi2 i (+ j 1)) (vi2 (+ i 1) j)
                                    (vi2 (+ i 1) j) (vi2 i (+ j 1)) (vi2 (+ i 1) (+ j 1)))))))
    (list (f32-from-list pos) (f32-from-list idx))))
(define *orb-mesh* (psphere-mesh 4 8))
(define (norm3 v)
  (let ((l (max 0.0001 (sqrt (+ (* (car v) (car v)) (* (cadr v) (cadr v)) (* (caddr v) (caddr v)))))))
    (list (/ (car v) l) (/ (cadr v) l) (/ (caddr v) l))))
(define (sun-dir tod)
  (let* ((p (/ (- tod 6.0) 12.0))
         (elev (sin (* 3.14159 p)))
         (horiz (cos (* 3.14159 p))))
    (norm3 (list (* horiz 0.85) (* elev 0.8) (- 0.15 (* horiz 0.45))))))
(define (orb-insts tod)
  ;; солнце
  (let* ((sd (sun-dir tod))
         (low (max 0.0 (- 0.35 (cadr sd))))
         (scr (+ 0.95 (min 0.05 low)))
         (scg (- 0.88 (* 0.45 (min 1.0 (* low 2.2)))))
         (scb (- 0.72 (* 0.55 (min 1.0 (* low 2.6)))))
         (md (norm3 (list (- (car sd)) (max 0.12 (- (cadr sd))) (- (caddr sd))))))
    (append
     (if (> (cadr sd) -0.10)
         (list (* (car sd) 325.0) (* (cadr sd) 325.0) (* (caddr sd) 325.0)
               20.0 20.0 20.0  0 0 0  scr scg scb)
         '())
     (if (and (< (cadr sd) 0.10) (> (cadr md) -0.02))
