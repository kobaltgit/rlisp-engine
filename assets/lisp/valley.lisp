;; размещение детерминированное: избегаем воды/пляжа/крутых склонов/камней
(define (tree-place i)
  (let* ((x (- (* 224.0 (u01 i 0.0)) 112.0))
         (z (- (* 224.0 (u01 i 0.41)) 112.0))
         (h (valley-h x z))
         (sl (valley-slope x z))
         (r (sqrt (+ (* x x) (* z z)))))
    (list x z h sl r)))
(define (ok-tree? p i)
  (let* ((x (car p)) (z (cadr p)) (h (caddr p)) (sl (cadddr p)) (r (nth p 4)))
    (and (> h 0.7) (< h 9.0) (< sl 0.42) (< r 88.0)
         (> (hash2 i 91.7) 0.12)
         ;; поляна у точки старта
         (> (+ (* (- x -40.0) (- x -40.0)) (* (- z -4.0) (- z -4.0))) 64.0))))
(define (build-trees)
  (define (go i pine broad acc)
    (if (>= i 400)
        (reverse acc)
        (let ((p (tree-place i)))
          (if (ok-tree? p i)
              (let* ((hpine (> (caddr p) 3.0))
                     (want-pine (if hpine
                                    (> (hash2 i 31.1) 0.22)
                                    (< (hash2 i 31.1) 0.24))))
                (if (and want-pine (< pine 96))
                    (go (+ i 1) (+ pine 1) broad
                        (cons (list (car p) (cadr p) (caddr p)
                                    (+ 2.0 (* 1.4 (hash2 i 7.7)))   ; высота
                                    (* 6.28318 (hash2 i 13.1))      ; фаза ветра
                                    'pine)
                              acc))
                    (if (< broad 44)
                        (go (+ i 1) pine (+ broad 1)
                            (cons (list (car p) (cadr p) (caddr p)
                                        (+ 1.7 (* 1.1 (hash2 i 7.7)))
                                        (* 6.28318 (hash2 i 13.1))
                                        'leaf)
                                  acc))
                        (go (+ i 1) pine broad acc))))
              (go (+ i 1) pine broad acc)))))
  (go 0 0 0 '()))
(define *trees* (build-trees))
