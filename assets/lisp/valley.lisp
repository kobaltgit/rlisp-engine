;; ——— облака: текстурные билборды у горизонта, тон из палитры ———
(define (cloud-tex n)
  (let ((buf (tex-canvas n n)))
    (dotimes (y n)
      (dotimes (x n)
        (let ((i (* 4 (+ (* y n) x))))
          (f32set! buf i 208.0)
          (f32set! buf (+ i 1) 212.0)
          (f32set! buf (+ i 2) 222.0)
          (f32set! buf (+ i 3) 255.0))))
    (define (blob cx cy rad str)
      (dotimes (y n)
        (dotimes (x n)
          (let* ((dx (/ (- x cx) rad)) (dy (/ (- y cy) rad))
                 (d2 (+ (* dx dx) (* dy dy))))
            (if (< d2 1.0)
                (let* ((f (* (- 1 d2) (- 1 d2) str))
                       (i (* 4 (+ (* y n) x))))
                  (f32set! buf i (+ (f32ref buf i) (* (- 255.0 (f32ref buf i)) f)))
                  (f32set! buf (+ i 1) (+ (f32ref buf (+ i 1)) (* (- 255.0 (f32ref buf (+ i 1))) f)))
                  (f32set! buf (+ i 2) (+ (f32ref buf (+ i 2)) (* (- 255.0 (f32ref buf (+ i 2))) f))))
                #f)))))
    (blob 29 38 15 0.95) (blob 42 31 12 0.9) (blob 49 41 13 0.85)
    (blob 35 48 13 0.85) (blob 22 30 10 0.8) (blob 56 30 10 0.75)
    (dotimes (y n)
      (dotimes (x n)
        (let* ((i (* 4 (+ (* y n) x)))
               (dx (* 2.05 (- (/ x n) 0.5)))
               (dy (* 2.05 (- (/ y n) 0.5)))
               (d (sqrt (+ (* dx dx) (* dy dy))))
               (e (max 0.0 (min 1.0 (* 1.25 (- 1.0 d)))))
               (r (f32ref buf i)) (g (f32ref buf (+ i 1))) (b (f32ref buf (+ i 2))))
          (f32set! buf i (+ (* r e) (* 200.0 (- 1.0 e))))
          (f32set! buf (+ i 1) (+ (* g e) (* 204.0 (- 1.0 e))))
          (f32set! buf (+ i 2) (+ (* b e) (* 214.0 (- 1.0 e))))
          (f32set! buf (+ i 3) 255.0))))
    (texture-upload n n buf)))
(define (cloud-vc-mesh)
  ;; юнит-квад 5x5 с радиальным k-фактором: край растворяется в цвет горизонта
  (let ((pos '()) (idx '()) (karr '()))
    (dotimes (i 5)
      (dotimes (j 5)
        (let* ((u (- (/ i 4.0) 0.5))
               (v (- (/ j 4.0) 0.5))
               (d (* 2.0 (sqrt (+ (* u u) (* v v))))))
          (set! pos (append pos (list u v 0.0)))
          (set! karr (append karr (list (max 0.0 (min 1.0 (- (* d 1.25) 0.25)))))))))
    (define (vi i j) (+ (* i 5) j))
    (dotimes (i 4)
      (dotimes (j 4)
        (set! idx (append idx (list (vi i j) (vi i (+ j 1)) (vi (+ i 1) (+ j 1))
                                    (vi i j) (vi (+ i 1) (+ j 1)) (vi (+ i 1) j))))))
    (list (f32-from-list pos) (f32-from-list idx) (f32-from-list karr))))
