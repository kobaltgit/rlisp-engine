;; МИНИМАЛЬНЫЙ draw: только небо + пески (диагностика патчей)
(define (draw)
  (let* ((wh (window-size)))
    (set! *screen-w* (car wh))
    (set! *screen-h* (cadr wh)))
  (let* ((eye (list 0 (+ (th 0 -14) *eye-h*) -14))
         (target (list 0 (+ (cadr eye) -1.0) -24))
         (mvp (camera-mvp eye target 0.95)))
    (gpu3d-clear 0.72 0.82 0.90)
    (gpu3d-view 0 (cadr eye) -14)
    (gpu3d-fog 0.72 0.82 0.90 0.0)
    (gpu3d-light 0.40 0.68 0.30 0.50 0.0 0.55 44)
    ;; небодом off
    (gpu3d-light 0.40 0.68 0.30 0.50 0.78 0.55 44)
    (gpu3d-fog 0.72 0.82 0.90 0.012)
    (gpu3d-mesh-vc (car *ter*) *ter-uv* (cadr *ter*) (caddr *ter*)
                   (mat-identity) mvp 0)
    (gpu3d-flush-alpha)
    (draw-text "MIN SKY+TERRAIN" 8 5 1 (list 1 1 1))
    (gpu-present)))
(define (update dt) (poll-input))
