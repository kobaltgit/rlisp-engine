(load "core.lisp")(load "textures.lisp")(load "font.lisp")(load "graphics.lisp")(load "input.lisp")(load "render3d.lisp")
(load "ruiner.lisp")
;; эмуляция демо-боя: 10 демонов (7 спавна + 3 линии), погоня, 5 выстрелов
(set! *enemies*
      (cons (cons7 (+ *px* 4.5) *pz* 30 'chase 0.0 *pa* 0.0)
            (cons (cons7 (+ *px* 8.0) (+ *pz* 0.9) 34 'chase 0.0 (+ *pa* 0.12) 0.0)
                  (cons (cons7 (+ *px* 12.0) (- *pz* 1.4) 38 'chase 0.0 (- *pa* 0.1) 0.0)
                        *enemies*))))
(define (demo-frame dt)
  (update-enemies! dt))
(dotimes (i 90) (demo-frame 0.016))
(fire!) (demo-frame 0.016)
(fire!) (dotimes (i 30) (demo-frame 0.016))
(fire!) (dotimes (i 30) (demo-frame 0.016))
(fire!) (dotimes (i 30) (demo-frame 0.016))
(fire!) (dotimes (i 30) (demo-frame 0.016))
(print (string-append "score=" (number->string *score*)
                      " ammo=" (number->string *ammo*)
                      " hp=" (number->string *hp*)
                      " kills=" (number->string *kills*)))
(define (show-es es)
  (if (null? es)
      #f
      (begin
        (print (string-append "  e hp=" (number->string (caddr (car es)))
                              " d2=" (number->string (+ (* (- (car (car es)) *px*) (- (car (car es)) *px*))
                                                       (* (- (cadr (car es)) *pz*) (- (cadr (car es)) *pz*))))))
        (show-es (cdr es)))))
(show-es *enemies*)
