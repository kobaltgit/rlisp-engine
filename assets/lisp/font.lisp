;; font.lisp — растровый шрифт 3x5 как данные.
;; Философия ТЗ: «Code is compiled, data is built» — глифы это S-выражения,
;; draw-text (graphics.lisp) разворачивает их в сырые gpu-fill-rect.
;; Каждый глиф — 5 строк-битмасок по 3 пикселя (бит 2 — левый столбец).

(define *font* (make-table))
(table-set! *font* "A" (list 2 5 7 5 5))
(table-set! *font* "C" (list 3 4 4 4 3))
(table-set! *font* "E" (list 7 4 6 4 7))
(table-set! *font* "G" (list 3 4 5 5 3))
(table-set! *font* "I" (list 7 2 2 2 7))
(table-set! *font* "K" (list 5 5 6 5 5))
(table-set! *font* "L" (list 4 4 4 4 7))
(table-set! *font* "M" (list 5 7 5 5 5))
(table-set! *font* "O" (list 2 5 5 5 2))
(table-set! *font* "P" (list 7 5 7 4 4))
(table-set! *font* "R" (list 6 5 6 5 5))
(table-set! *font* "S" (list 3 4 2 1 6))
(table-set! *font* "T" (list 7 2 2 2 2))
(table-set! *font* "V" (list 5 5 5 5 2))
(table-set! *font* "W" (list 5 5 5 7 5))
(table-set! *font* " " (list 0 0 0 0 0))
(table-set! *font* "0" (list 7 5 5 5 7))
(table-set! *font* "1" (list 2 6 2 2 7))
(table-set! *font* "2" (list 7 1 7 4 7))
(table-set! *font* "3" (list 7 1 3 1 7))
(table-set! *font* "4" (list 5 5 7 1 1))
(table-set! *font* "5" (list 7 4 7 1 7))
(table-set! *font* "6" (list 7 4 7 5 7))
(table-set! *font* "7" (list 7 1 1 2 2))
(table-set! *font* "8" (list 7 5 7 5 7))
(table-set! *font* "9" (list 7 5 7 1 7))
;; v0.2: расширение алфавита для 3D-демо (ORBITAL)
(table-set! *font* "B" (list 6 5 6 5 6))
(table-set! *font* "D" (list 6 5 5 5 6))
(table-set! *font* "F" (list 7 4 6 4 4))
(table-set! *font* "H" (list 5 5 7 5 5))
(table-set! *font* "U" (list 5 5 5 5 7))
(table-set! *font* "X" (list 5 5 2 5 5))
(table-set! *font* "Y" (list 5 5 2 2 2))
(table-set! *font* "Z" (list 7 1 2 4 7))
(table-set! *font* "N" (list 5 7 7 5 5))
(table-set! *font* ":" (list 0 2 0 2 0))
(table-set! *font* "/" (list 1 1 2 4 4))
(table-set! *font* "-" (list 0 0 7 0 0))

;; ——— кириллица (этап 28): те же 3x5, uppercase + lowercase-алиасы ———
;; Формы согласованы с латиницей: А/Е/К/М/Н?/О/Р/С/Т/Х совпадают с латинскими.
(table-set! *font* "А" (list 2 5 7 5 5))
(table-set! *font* "Б" (list 6 4 6 5 6))
(table-set! *font* "В" (list 6 5 6 5 6))
(table-set! *font* "Г" (list 7 4 4 4 4))
(table-set! *font* "Д" (list 2 5 5 7 7))
(table-set! *font* "Е" (list 7 4 6 4 7))
(table-set! *font* "К" (list 5 5 6 5 5))
(table-set! *font* "М" (list 5 7 5 5 5))
(table-set! *font* "О" (list 2 5 5 5 2))
(table-set! *font* "Р" (list 7 5 7 4 4))
(table-set! *font* "С" (list 3 4 4 4 3))
(table-set! *font* "Т" (list 7 2 2 2 2))
(table-set! *font* "Х" (list 5 5 2 5 5))
(table-set! *font* "Ж" (list 5 7 2 7 5))
(table-set! *font* "З" (list 3 4 2 1 6))
(table-set! *font* "И" (list 5 5 5 5 6))
(table-set! *font* "Й" (list 5 5 5 5 2))
(table-set! *font* "Л" (list 1 5 5 5 5))
(table-set! *font* "Н" (list 5 5 7 5 5))
(table-set! *font* "П" (list 7 5 5 5 5))
(table-set! *font* "У" (list 5 5 7 1 2))
(table-set! *font* "Ф" (list 2 7 7 2 2))
(table-set! *font* "Х" (list 5 5 2 5 5))
(table-set! *font* "Ц" (list 5 5 5 7 1))
(table-set! *font* "Ч" (list 5 7 1 1 1))
(table-set! *font* "Ш" (list 7 5 5 5 7))
(table-set! *font* "Щ" (list 5 5 5 7 7))
(table-set! *font* "Ъ" (list 6 0 7 5 7))
(table-set! *font* "Ы" (list 5 5 5 7 5))
(table-set! *font* "Ь" (list 4 4 6 5 6))
(table-set! *font* "Э" (list 3 1 7 1 3))
(table-set! *font* "Ю" (list 6 5 7 5 6))
(table-set! *font* "Я" (list 4 2 7 5 5))
;; Ё и строчные: draw-text работает по символам, даём алиасы
(table-set! *font* "Ё" (list 7 4 6 4 7))
(define (font-alias! up low)
  (table-set! *font* low (table-get *font* up #f)))
(font-alias! "А" "а") (font-alias! "Б" "б") (font-alias! "В" "в")
(font-alias! "Г" "г") (font-alias! "Д" "д") (font-alias! "Е" "е")
(font-alias! "Ё" "ё") (font-alias! "Ж" "ж") (font-alias! "З" "з")
(font-alias! "И" "и") (font-alias! "Й" "й") (font-alias! "К" "к")
(font-alias! "Л" "л") (font-alias! "М" "м") (font-alias! "Н" "н")
(font-alias! "О" "о") (font-alias! "П" "п") (font-alias! "Р" "р")
(font-alias! "С" "с") (font-alias! "Т" "т") (font-alias! "У" "у")
(font-alias! "Ф" "ф") (font-alias! "Х" "х") (font-alias! "Ц" "ц")
(font-alias! "Ч" "ч") (font-alias! "Ш" "ш") (font-alias! "Щ" "щ")
(font-alias! "Ъ" "ъ") (font-alias! "Ы" "ы") (font-alias! "Ь" "ь")
(font-alias! "Э" "э") (font-alias! "Ю" "ю") (font-alias! "Я" "я")
