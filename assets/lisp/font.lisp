;; font.lisp — растровый шрифт 3x5 как данные.
;; Философия ТЗ: «Code is compiled, data is built» — глифы это S-выражения,
;; draw-text (graphics.lisp) разворачивает их в сырые gpu-fill-rect.
;; Каждый глиф — 5 строк-битмасок по 3 пикселя (бит 2 — левый столбец).

(define *font* (make-table))
(table-set! *font* "A" (list 2 5 7 5 5))
(table-set! *font* "C" (list 3 4 4 4 3))
(table-set! *font* "E" (list 7 4 6 4 7))
(table-set! *font* "G" (list 3 4 5 5 3))
(table-set! *font* "I" (list 7 2 2 2 7))
(table-set! *font* "K" (list 5 5 6 5 5))
(table-set! *font* "L" (list 4 4 4 4 7))
(table-set! *font* "M" (list 5 7 5 5 5))
(table-set! *font* "O" (list 2 5 5 5 2))
(table-set! *font* "P" (list 7 5 7 4 4))
(table-set! *font* "R" (list 6 5 6 5 5))
(table-set! *font* "S" (list 3 4 2 1 6))
(table-set! *font* "T" (list 7 2 2 2 2))
(table-set! *font* "V" (list 5 5 5 5 2))
(table-set! *font* "W" (list 5 5 5 7 5))
(table-set! *font* " " (list 0 0 0 0 0))
(table-set! *font* "0" (list 7 5 5 5 7))
(table-set! *font* "1" (list 2 6 2 2 7))
(table-set! *font* "2" (list 7 1 7 4 7))
(table-set! *font* "3" (list 7 1 3 1 7))
(table-set! *font* "4" (list 5 5 7 1 1))
(table-set! *font* "5" (list 7 4 7 1 7))
(table-set! *font* "6" (list 7 4 7 5 7))
(table-set! *font* "7" (list 7 1 1 2 2))
(table-set! *font* "8" (list 7 5 7 5 7))
(table-set! *font* "9" (list 7 5 7 1 7))
;; v0.2: расширение алфавита для 3D-демо (ORBITAL)
(table-set! *font* "B" (list 6 5 6 5 6))
(table-set! *font* "D" (list 6 5 5 5 6))
(table-set! *font* "F" (list 7 4 6 4 4))
(table-set! *font* "H" (list 5 5 7 5 5))
(table-set! *font* "U" (list 5 5 5 5 7))
(table-set! *font* "X" (list 5 5 2 5 5))
(table-set! *font* "Y" (list 5 5 2 2 2))
(table-set! *font* "Z" (list 7 1 2 4 7))
