;; ——— пальмы и камни ———
(define *trunk-mesh*
  (mesh-make (list -0.16 0 -0.16  0.16 0 -0.16  0.16 0 0.16  -0.16 0 0.16
                   -0.10 4.2 -0.10  0.10 4.2 -0.10  0.10 4.2 0.10  -0.10 4.2 0.10)
             (list 0 1 2  0 2 3  4 6 5  4 7 6  0 4 5  0 5 1  1 5 6  1 6 2  2 6 7  2 7 3  3 7 4  3 4 0)))
(define *frond-mesh*
  (mesh-make (list -1.6 0 0  1.6 0 0  0 0 -1.6  0 0 1.6
                   -0.9 0.35 0  0.9 0.35 0  0 0.35 -0.9  0 0.35 0.9
                   -1.2 -0.18 0  1.2 -0.18 0  0 -0.18 -1.2  0 -0.18 1.2)
             (list 0 4 8  1 5 9  2 6 10  3 7 11
                   8 4 0  9 5 1  10 6 2  11 7 3)))
(define *palms* (list (list -14 -6 1.0) (list -18 9 1.15) (list 12 -14 0.9)
                      (list 16 10 1.1) (list -6 18 1.0) (list 7 19 0.95)
                      (list -22 -18 1.2) (list 20 -4 1.05)))
(define (frond-insts t)
  (define (go ps acc)
    (if (null? ps)
        acc
        (let* ((p (car ps))
               (x (car p)) (z (cadr p)) (s (caddr p))
               (y (+ (th x z) 4.2))
               (sway (* 0.09 (sin (+ (* t 1.1) x z)))))
          (go (cdr ps)
              (append acc (list x y z s s s sway 0 0 0.30 0.52 0.20))))))
  (go *palms* '()))
(define (palm-insts t)
  (define (go ps acc)
    (if (null? ps)
        acc
        (let* ((p (car ps))
               (x (car p)) (z (cadr p)) (s (caddr p))
               (y (th x z)))
          (go (cdr ps)
              (append acc (list x y z s s s 0 0 0 0.42 0.30 0.18))))))
  (go *palms* '()))
(define *rock-mesh* (sphere-mesh 3 8))
(define *rocks* (list (list -9 4 0.7) (list 10 6 0.9) (list -3 -16 1.1)
                      (list 14 -20 0.8) (list -26 2 1.0) (list 25 22 1.2)))
(define (rock-insts)
  (define (go rs acc)
    (if (null? rs)
        acc
        (let* ((r (car rs))
               (x (car r)) (z (cadr r)) (s (caddr r)))
          (go (cdr rs)
              (append acc (list x (+ (th x z) (* 0.15 s)) z
                                s (* 0.8 s) s 0 0 0 0.62 0.58 0.52))))))
  (go *rocks* '()))

;; ——— небо (этап 20) ———
(define (skydome-mesh)
  (let ((pos '()) (vc '()) (idx '()) (vi 0))
    (define (go i)
      (if (>= i 7)
          #f
          (let ((phi (* 3.14159 (/ i 6.5))))
            (dotimes (j 17)
              (let* ((th2 (* 6.28318 (/ j 16)))
                     (y (max -0.14 (cos phi)))
                     (rr (sin phi))
                     (k (sqrt (max 0.0 y))))
                (set! pos (append pos (list (* 340 rr (cos th2))
                                            (* 340 y)
                                            (* 340 rr (sin th2)))))
                (set! vc (append vc (list (+ (* 0.80 (- 1 k)) (* 0.28 k))
                                          (+ (* 0.86 (- 1 k)) (* 0.52 k))
                                          (+ (* 0.96 (- 1 k)) (* 0.90 k))
                                          1.0)))))
            (if (< i 6)
                (dotimes (j 16)
                  (let ((a (+ vi j)) (b (+ vi j 1)) (c (+ vi 17 j)) (d (+ vi 17 j 1)))
                    (set! idx (append idx (list a c b  b c d)))))
                #f)
            (set! vi (+ vi 17))
            (go (+ i 1)))))
    (go 0)
    (list (f32-from-list pos) (f32-from-list vc) (f32-from-list idx))))
(define *sky-mesh* (skydome-mesh))
(define *sky-uv* (make-f32vec (* 119 2) 0.0))
(define *sun-mesh* (sphere-mesh 4 8))
(define (sun-inst)
  (let* ((r 320.0)
         (ce (* r 0.8 0.9986))
         (cz (* r 0.6 0.9986)))
    (list (- ce) (* r 0.0872) (- cz) 24.0 24.0 24.0 0 0 0 1.6 1.5 1.15)))

(define (cloud-tex n)
  (let ((buf (tex-canvas n n)))
    (dotimes (y n)
      (dotimes (x n)
        (let ((i (* 4 (+ (* y n) x))))
          (f32set! buf i 214.0)
          (f32set! buf (+ i 1) 219.0)
          (f32set! buf (+ i 2) 230.0)
          (f32set! buf (+ i 3) 255.0))))
    (define (blob cx cy rad str)
      (dotimes (y n)
        (dotimes (x n)
          (let* ((dx (/ (- x cx) rad)) (dy (/ (- y cy) rad))
                 (d2 (+ (* dx dx) (* dy dy))))
            (if (< d2 1.0)
                (let* ((f (* (- 1 d2) (- 1 d2) str))
                       (i (* 4 (+ (* y n) x))))
                  (f32set! buf i (+ (f32ref buf i) (* (- 255.0 (f32ref buf i)) f)))
                  (f32set! buf (+ i 1) (+ (f32ref buf (+ i 1)) (* (- 255.0 (f32ref buf (+ i 1))) f)))
                  (f32set! buf (+ i 2) (+ (f32ref buf (+ i 2)) (* (- 255.0 (f32ref buf (+ i 2))) f))))
                #f)))))
    (blob 29 38 15 0.95) (blob 42 31 12 0.9) (blob 49 41 13 0.85)
    (blob 35 48 13 0.85) (blob 22 30 10 0.8) (blob 56 30 10 0.75)
    (dotimes (y n)
      (dotimes (x n)
        (let* ((i (* 4 (+ (* y n) x)))
               (dx (* 2.05 (- (/ x n) 0.5)))
               (dy (* 2.05 (- (/ y n) 0.5)))
               (d (sqrt (+ (* dx dx) (* dy dy))))
               (e (max 0.0 (min 1.0 (* 1.25 (- 1.0 d)))))
               (r (f32ref buf i)) (g (f32ref buf (+ i 1))) (b (f32ref buf (+ i 2))))
          (f32set! buf i (+ (* r e) (* 214.0 (- 1.0 e))))
          (f32set! buf (+ i 1) (+ (* g e) (* 219.0 (- 1.0 e))))
          (f32set! buf (+ i 2) (+ (* b e) (* 230.0 (- 1.0 e))))
          (f32set! buf (+ i 3) 255.0))))
    (texture-upload n n buf)))
(define *cloud-tex* (cloud-tex 64))
(define *cloud-mesh* (mesh-make (list -0.5 0 0   0.5 0 0   0.5 1 0   -0.5 1 0)
                                (list 0 1 2  0 2 3)))
(define *cloud-uv* (f32-from-list (list 0 0  1 0  1 1  0 1)))
(define *clouds* (list (list -110 -55 105 30 0.5 0.0)
                       (list -50 -160 130 36 0.42 40.0)
                       (list -185 -15 95 26 0.62 80.0)
                       (list -135 -105 115 32 0.5 120.0)))
(define (cloud-insts t yaw)
  (define (go cs acc)
    (if (null? cs)
        acc
        (let* ((c (car cs))
               (x0 (car c)) (z0 (cadr c)) (w (caddr c)) (hgt (cadddr c))
               (sp (nth c 4)) (ph (nth c 5))
               (x (+ x0 (* 7.0 (sin (+ (* t sp) ph)))))
               (z (+ z0 (* 5.0 (cos (+ (* t (* sp 0.8)) ph)))))
               (y (+ 16.0 (* 1.8 (sin (+ (* t sp 0.7) ph))))))
          (go (cdr cs)
              (append acc (list x y z w hgt 1.0 yaw 0 0 1.05 1.08 1.15))))))
  (go *clouds* '()))

;; ——— частицы/тени/трассеры ———
(define *parts-pool* 0)
(define *parts-out* (make-f32vec 32768 0.0))
(define *part-mesh* (mesh-make (list -0.5 -0.5 0  0.5 -0.5 0  0.5 0.5 0  -0.5 0.5 0)
                               (list 0 1 2  0 2 3)))
(define *shadow-mesh*
  (let ((pos '()) (idx '()))
    (dotimes (j 11)
      (let ((a (* 6.28318 (/ j 10))))
        (set! pos (append pos (list (* 0.85 (cos a)) 0.0 (* 0.85 (sin a)))))))
    (set! pos (append pos (list 0.0 0.0 0.0)))
    (dotimes (j 10)
      (set! idx (append idx (list j 10 (+ j 1)))))
    (mesh-make pos idx)))
(define *tracers* '())

;; ——— игрок ———
(defpersistent *px* 0.0)
(defpersistent *pz* -14.0)
(defpersistent *yaw* 0.0)
(defpersistent *hp* 100)
(defpersistent *ammo* 8)
(defpersistent *reload-t* 0.0)
(defpersistent *kills* 0)
(defpersistent *wave* 1)
(defpersistent *wave-left* 0)
(defpersistent *state* "intro")
(defpersistent *bob* 0.0)
(defpersistent *recoil* 0.0)
(defpersistent *flash* 0.0)
(defpersistent *hitpulse* 0.0)
(defpersistent *shake* 0.0)
(defpersistent *game-t* 0.0)
(defpersistent *shots* 0)
(defpersistent *dead-t* 0.0)
(defpersistent *fps-last* 0.0)
(defpersistent *fps-last-val* 0.0)
(defpersistent *fps-t0* 0.0)
(defpersistent *fps-frames* 0)

;; ——— враги: лисы — таблицы с полями x/z/hp/st/t/anim/pitch ———
(define *foxes* '())
(define *fox-model* #f)

(define (spawn-wave! n)
  (dotimes (k n)
    (let* ((az (+ *yaw*
                  (* 0.9 (- (/ (+ k 0.5) n) 0.5) 2.0)   ; фронт ±70°
                  (* 0.5 (hash2 k *wave*))))
           (r (+ 17.0 (* 8.0 (hash2 k 13))))
           (f (make-table)))
      ;; спавн ВОКРУГ ИГРОКА фронтом к взгляду (az отсчитывается от yaw);
      ;; старый вариант считал кольцо от центра мира — лисы за спиной
      (table-set! f 'x (+ *px* (* r (sin az))))
      (table-set! f 'z (- *pz* (* r (cos az))))
      (table-set! f 'hp 100)
      (table-set! f 'st "run")
      (table-set! f 't 0.0)
      (table-set! f 'anim 0.0)
      (table-set! f 'pitch 0.0)
      (set! *foxes* (append *foxes* (list f))))
    #f)
  (set! *wave-left* (+ *wave-left* n)))

;; ——— звуки ———
(define *audio-ready* #f)
(define (audio-init!)
  (if *audio-ready*
      #f
      (begin
        (audio-preset-laser 'shot 950.0)
        (audio-preset-explosion 'hit)
        (audio-preset-laser 'bite 210.0)
        (audio-preset-laser 'reload 470.0)
        (audio-preset-explosion 'wind)
        (set! *audio-ready* #t)
        #t)))

;; ——— сброс ———
(define (reset-game!)
  (set! *px* 0.0) (set! *pz* -14.0) (set! *yaw* 0.0)
  (set! *hp* 100) (set! *ammo* 8) (set! *reload-t* 0.0)
  (set! *kills* 0) (set! *wave* 1)
  (set! *wave-left* 0)
  (set! *state* "play")
  (set! *foxes* '())
  (set! *tracers* '())
  (part-clear! *parts-pool*)
  (spawn-wave! 3)
  (set! *game-t* 0.0)
  (play-music 'wind 0.25))

;; ——— стрельба ———
(define (raycast-fox!)
  (let ((best #f) (best-d 1e9)
        (dx (sin *yaw*)) (dz (- (cos *yaw*))))
    (define (go fs)
      (if (null? fs)
          #f
          (let* ((f (car fs))
                 (vx (- (table-get f 'x) *px*))
                 (vz (- (table-get f 'z) *pz*))
                 (proj (+ (* vx dx) (* vz dz))))
            (if (> proj 0.5)
                (let* ((ox (- vx (* proj dx)))
                       (oz (- vz (* proj dz)))
                       (dist (sqrt (+ (* ox ox) (* oz oz)))))
                  (if (and (< dist 3.0) (< proj best-d))
                      (begin (set! best f) (set! best-d proj))
                      #f))
                #f)
            (go (cdr fs)))))
    (go *foxes*)
    best))

(define (shoot!)
  (if (not (string=? *state* "play"))
      #f
      (if (> *reload-t* 0.0)
          #f
          (if (= *ammo* 0)
              (begin (set! *reload-t* 1.15) (play-sfx 'reload 0.5))
              (let* ((dx (sin *yaw*))
                     (dz (- (cos *yaw*)))
                     (ey (+ (th *px* *pz*) *eye-h*))
                     (mzx (+ *px* (* dx 0.7) (* (cos *yaw*) 0.25)))
                     (mzz (+ *pz* (* dz 0.7) (* (sin *yaw*) 0.25)))
                     (target (raycast-fox!)))
                (set! *ammo* (- *ammo* 1))
                (set! *shots* (+ *shots* 1))
                (set! *recoil* 1.0)
                (set! *flash* 1.0)
                (set! *shake* 0.5)
                (play-sfx 'shot 0.9 (+ 0.85 (* 0.3 (hash2 *shots* 3))))
                (if target
                    (let* ((tx (table-get target 'x))
                           (tz (table-get target 'z))
                           (ty (+ (th tx tz) 0.45)))
                      (set! *tracers*
                            (cons (list mzx (- ey 0.06) mzz tx ty tz 0.09) *tracers*))
                      (part-burst! *parts-pool* 9 tx ty tz 0 2.0 0 1.3 0.95 0.9 0.7 0.95 0.9 0.78)
                      (table-set! target 'hp (- (table-get target 'hp) 34))
                      (if (<= (table-get target 'hp) 0)
                          (begin
                            (table-set! target 'st "dying")
                            (table-set! target 't 0.0)
                            (set! *kills* (+ *kills* 1))
                            (set! *wave-left* (- *wave-left* 1))
                            (play-sfx 'hit 1.0)
                            (part-burst! *parts-pool* 14 tx (+ ty 0.3) tz 0 2.4 0 1.7
                                         0.95 0.92 0.85 0.85 0.8 0.75))
                          #f))
                    (let* ((hitx (+ *px* (* dx 32)))
                           (hitz (+ *pz* (* dz 32)))
                           (hity (th hitx hitz)))
                      (set! *tracers*
                            (cons (list mzx (- ey 0.06) mzz hitx (+ hity 0.2) hitz 0.09)
                                  *tracers*))
                      (part-burst! *parts-pool* 7 hitx (+ hity 0.2) hitz 0 2.2 0 1.1
                                   0.87 0.80 0.62 0.80 0.74 0.58)))
                (if (= *ammo* 0)
                    (begin (set! *reload-t* 1.15) (play-sfx 'reload 0.6))
                    #f))))))

;; ——— обновление ———
(define (update dt)
  (poll-input)
  (audio-init!)
  (set! *game-t* (+ *game-t* dt))
  ;; fps-счётчик: окна по 120 кадров
  (set! *fps-frames* (+ *fps-frames* 1))
  (if (>= *fps-frames* 120)
      (begin
        (set! *fps-last-val* (floor (/ 120.0 (max 0.001 (- *game-t* *fps-t0*)))))
        (set! *fps-t0* *game-t*)
        (set! *fps-frames* 0))
      #f)
  (set! *flash* (max 0.0 (- *flash* (* 6.0 dt))))
  (set! *hitpulse* (max 0.0 (- *hitpulse* (* 2.2 dt))))
  (set! *recoil* (max 0.0 (- *recoil* (* 5.0 dt))))
  (set! *shake* (max 0.0 (- *shake* (* 4.0 dt))))
  (if (and (string=? *state* "intro") (or (key-pressed? "f") (key-pressed? " ") (key-pressed? "w")))
      (begin (set! *state* "play") (play-music 'wind 0.2))
      #f)
  (if (and (string=? *state* "dead") (key-pressed? "r"))
      (reset-game!)
      #f)
  (if (string=? *state* "play")
      (begin
        ;; движение
        (let ((mv 0.0))
          (if (key-down? "w") (set! mv (+ mv 4.6)) #f)
          (if (key-down? "s") (set! mv (- mv 3.2)) #f)
          (if (key-down? "a") (set! *yaw* (+ *yaw* (* 2.3 dt))) #f)
          (if (key-down? "d") (set! *yaw* (- *yaw* (* 2.3 dt))) #f)
          (if (or (key-pressed? "f") (key-pressed? " ")) (shoot!) #f)
          (let* ((nx (+ *px* (* (sin *yaw*) mv dt)))
                 (nz (+ *pz* (* (- 0 (cos *yaw*)) mv dt))))
            (set! *px* (max -41 (min 41 nx)))
            (set! *pz* (max -41 (min 41 nz)))
            (set! *bob* (+ *bob* (* dt (if (> mv 0.1) 9.5 0.0))))
            #f))
        ;; перезарядка
        (if (> *reload-t* 0.0)
            (let ((nt (- *reload-t* dt)))
              (set! *reload-t* (max 0.0 nt))
              (if (and (= *reload-t* 0.0) (> nt 0.0))
                  (begin (set! *ammo* 8) (play-sfx 'reload 0.8 1.3))
                  #f))
            #f)
        ;; волна пройдена
        (if (<= *wave-left* 0)
            (begin
              (set! *wave* (+ *wave* 1))
              (set! *hp* (min 100 (+ *hp* 40)))
              (spawn-wave! (+ 2 *wave*))
              (play-sfx 'reload 0.9 0.6))
            #f)
        ;; лисы
        (step-foxes! dt)
        ;; трассеры
        (step-tracers! dt)
        (part-step! *parts-pool* dt 0.0 -9.0 0.0 0.5))
      #f))

(define (step-foxes! dt)
  (let ((acc '()))
    (define (go fs)
      (if (null? fs)
          #f
          (let* ((f (car fs))
                 (st (table-get f 'st)))
            (if (string=? st "dying")
                (let ((nt (+ (table-get f 't) dt)))
                  (table-set! f 't nt)
                  (table-set! f 'pitch (min 1.57 (* nt 3.2)))
                  (if (> nt 1.8)
                      #f
                      (begin (set! acc (cons f acc)) #f))
                  (go (cdr fs)))
                (let* ((vx (- *px* (table-get f 'x)))
                       (vz (- *pz* (table-get f 'z)))
                       (d (max 0.001 (sqrt (+ (* vx vx) (* vz vz)))))
                       (sp (+ 2.6 (* 0.3 *wave*)))
                       (step (if (> d 1.5) sp 0.0))
                       (ft (+ (table-get f 't) dt)))
                  (table-set! f 'x (+ (table-get f 'x) (* (/ vx d) step dt)))
                  (table-set! f 'z (+ (table-get f 'z) (* (/ vz d) step dt)))
                  (table-set! f 'anim (+ (table-get f 'anim) (* dt (if (> step 0) 2.2 0.5))))
                  (table-set! f 't ft)
                  ;; укус
                  (if (< d 1.5)
                      (if (> ft 1.3)
                          (begin
                            (table-set! f 't 0.0)
                            (set! *hp* (max 0 (- *hp* 8)))
                            (set! *hitpulse* 1.0)
                            (set! *shake* 0.7)
                            (play-sfx 'bite 0.85)
                            (if (<= *hp* 0) (begin (set! *state* "dead") (set! *dead-t* *game-t*)) #f))
                          #f)
                      #f)
                  (set! acc (cons f acc))
                  (go (cdr fs)))))))
    (go *foxes*)
    (set! *foxes* acc)))

(define (step-tracers! dt)
  (let ((acc '()))
    (define (go ts)
      (if (null? ts)
          #f
          (let* ((tr (car ts))
                 (life (- (nth tr 6) dt)))
            (if (> life 0.0)
                (begin
                  (set! acc (cons (append (list (car tr) (cadr tr) (caddr tr)
                                                (nth tr 3) (nth tr 4) (nth tr 5))
                                          (list life))
                                  acc))
                  (go (cdr ts)))
                (go (cdr ts))))))
    (go *tracers*)
    (set! *tracers* acc)))

;; ——— отрисовка ———
(define (mat-trans tx ty tz)
  (f32-from-list (list 1 0 0 tx  0 1 0 ty  0 0 1 tz  0 0 0 1)))

;; матрица «лицом к игроку» из нормированного направления (fx fz):
;; модель Fox нативно смотрит в +Z (проверено рендером с камер ±Z:
;; с +Z видна морда, с −Z — спина и хвост) → нужно Ry·(0,0,1) = (fx, fz),
;; Ry·(0,0,1) = (sinθ, cosθ) → строки (fz, fx) / (−fx, fz)
;; (старая версия направляла −Z — лисы бежали спиной вперёд)
(define (mat-face fx fz)
  (f32-from-list (list fz 0 fx 0
                       0 1 0 0
                       (- fx) 0 fz 0
                       0 0 0 1)))

(define (fox-mat f)
  (let* ((x (table-get f 'x)) (z (table-get f 'z))
         (pitch (table-get f 'pitch))
         (d (max 0.0001 (sqrt (+ (* (- *px* x) (- *px* x))
                                 (* (- *pz* z) (- *pz* z))))))
         (fx (/ (- *px* x) d))
         (fz (/ (- *pz* z) d))
         (y (- (th x z) (* *fox-scale* *fox-bind-y*))))
    (mat4-mul (mat-trans x y z)
              (mat4-mul (mat-face fx fz)
                        (mat4-mul (mat-rotate-x pitch)
                                  (mat-scale *fox-scale* *fox-scale* *fox-scale*))))))

(define (parts-insts n)
  (define (go k acc)
    (if (>= k n)
        acc
        (let* ((i (* k 8))
               (px (f32ref *parts-out* i))
               (py (f32ref *parts-out* (+ i 1)))
               (pz (f32ref *parts-out* (+ i 2)))
               (sz (f32ref *parts-out* (+ i 3)))
               (cr (f32ref *parts-out* (+ i 4)))
               (cg (f32ref *parts-out* (+ i 5)))
               (cb (f32ref *parts-out* (+ i 6)))
               (lf (f32ref *parts-out* (+ i 7)))
               (sc (* sz (+ 0.45 (* 0.55 lf))))
               (fk (+ 0.55 (* 0.45 lf))))
          (go (+ k 1)
              (append acc (list px py pz sc sc sc 0 0 0
                                (* cr fk) (* cg fk) (* cb fk)))))))
  (go 0 '()))

(define (draw-scene mvp t)
  ;; небо: только солнце (2D-градиент неба рисуется в draw ДО 3D-слоя;
  ;; небодом снят — при камере «с глаз» давал артефакты у горизонта)
  (gpu3d-fog 0.72 0.82 0.90 0.0)
  (gpu3d-light 0.40 0.68 0.30 0.50 0.0 0.55 44)
  (draw-batch *sun-mesh* (sun-inst) mvp)
  (gpu3d-light 0.40 0.68 0.30 0.50 0.78 0.55 44)
  (gpu3d-fog 0.72 0.82 0.90 0.012)
  ;; пески и вода
  (gpu3d-mesh-vc (car *ter*) *ter-uv* (cadr *ter*) (caddr *ter*)
                 (mat-identity) mvp 0)
  (gpu3d-alpha-blend 0.72)
  (gpu3d-mesh-vc (car *water*) *water-uv* *water-vc* (cadr *water*)
                 (mat-identity) mvp 0)
  (gpu3d-alpha-blend 1.0)
  ;; пальмы и камни
  (draw-batch *trunk-mesh* (palm-insts t) mvp)
  (gpu3d-alpha-blend 0.97)
  (draw-batch *frond-mesh* (frond-insts t) mvp)
  (gpu3d-alpha-blend 1.0)
  (draw-batch *rock-mesh* (rock-insts) mvp)
  ;; лисы
  (define (draw-foxes fs)
    (if (null? fs)
        #f
        (let ((f (car fs)))
          (draw-gltf-skin *fox-model* "Run" *game-t* (fox-mat f)
                          mvp 1.0 1.0 1.0)
          (gpu3d-alpha-blend 0.35)
          (draw-batch *shadow-mesh*
                      (list (table-get f 'x)
                            (+ (th (table-get f 'x) (table-get f 'z)) 0.05)
                            (table-get f 'z)
                            0.8 0.8 0.8 0 0 0 0.15 0.17 0.23)
                      mvp)
          (gpu3d-alpha-blend 1.0)
          (draw-foxes (cdr fs)))))
  (draw-foxes *foxes*)
  ;; трассеры
  (define (draw-tracers ts)
    (if (null? ts)
        #f
        (let ((tr (car ts)))
          (gpu3d-wire (f32-from-list (list (car tr) (cadr tr) (caddr tr)
                                           (nth tr 3) (nth tr 4) (nth tr 5)))
                      (f32-from-list (list 0 1))
                      (mat-identity) mvp 1.0 0.85 0.45)
          (draw-tracers (cdr ts)))))
  (draw-tracers *tracers*)
  ;; частицы
  (let ((n (part-dump! *parts-pool* *parts-out*)))
    (if (> n 0)
        (begin
          (gpu3d-alpha-blend 0.85)
          (draw-batch *part-mesh* (parts-insts n) mvp)
          (gpu3d-alpha-blend 1.0))
        #f))
  (gpu3d-flush-alpha))

;; вью-модель автомата
(define *wbody*
  (mesh-make (list -0.045 0 -0.26  0.045 0 -0.26  0.045 0 0.26  -0.045 0 0.26
                   -0.045 0.11 -0.26  0.045 0.11 -0.26  0.045 0.11 0.26  -0.045 0.11 0.26)
             (list 0 1 2  0 2 3  4 6 5  4 7 6  0 4 5  0 5 1
                   1 5 6  1 6 2  2 6 7  2 7 3  3 7 4  3 4 0)))
(define *wbarrel*
  (mesh-make (list -0.018 0 -0.5  0.018 0 -0.5  0.018 0 -0.26  -0.018 0 -0.26
                   -0.018 0.036 -0.5  0.018 0.036 -0.5  0.018 0.036 -0.26  -0.018 0.036 -0.26)
             (list 0 1 2  0 2 3  4 6 5  4 7 6  0 4 5  0 5 1
                   1 5 6  1 6 2  2 6 7  2 7 3  3 7 4  3 4 0)))
(define *muzzle-mesh*
  (mesh-make (list -0.03 0 0  0.03 0 0  0.03 0.03 0  -0.03 0.03 0)
             (list 0 1 2  0 2 3)))

(define (weapon-draw mvp-weapon)
  (let* ((bobx (* 0.012 (sin *bob*)))
         (boby (* 0.010 (abs (cos *bob*))))
         (rec (* 0.06 *recoil*))
         (wx (+ 0.26 bobx))
         (wy (- -0.23 boby (* 0.02 *recoil*)))
         (wz (- -0.52 rec))
         (model (mat4-mul (mat-trans wx wy wz) (mat-rotate-y -0.06))))
    (gpu3d-mesh (car *wbody*) (cadr *wbody*) model mvp-weapon 0.34 0.36 0.40)
    (gpu3d-mesh (car *wbarrel*) (cadr *wbarrel*) model mvp-weapon 0.20 0.20 0.23)
    (if (> *flash* 0.25)
        (begin
          (gpu3d-alpha-blend 0.9)
          (gpu3d-mesh (car *muzzle-mesh*) (cadr *muzzle-mesh*)
                      (mat4-mul model (mat-trans 0 0.02 -0.52))
                      mvp-weapon
                      (* 2.2 *flash*) (* 1.9 *flash*) (* 1.2 *flash*))
          (gpu3d-alpha-blend 1.0))
        #f)))

;; ——— HUD ———
(define (draw-hud)
  (let ((cx (/ *screen-w* 2)) (cy (/ *screen-h* 2)))
    (draw-rect (- cx 8) (- cy 1) 6 2 (list 0.95 0.95 0.95))
    (draw-rect (+ cx 2) (- cy 1) 6 2 (list 0.95 0.95 0.95))
    (draw-rect (- cx 1) (- cy 8) 2 6 (list 0.95 0.95 0.95))
    (draw-rect (- cx 1) (+ cy 2) 2 6 (list 0.95 0.95 0.95)))
  (let* ((hw (* 90 (/ *hp* 100.0)))
         (col (if (> *hp* 50) (list 0.35 0.85 0.4)
                  (if (> *hp* 25) (list 0.9 0.75 0.25) (list 0.9 0.3 0.25)))))
    (draw-rect 8 (- *screen-h* 18) 94 8 (list 0.08 0.10 0.14))
    (draw-rect 10 (- *screen-h* 16) hw 4 col)
    (draw-text (string-append "HP " (number->string *hp*))
               8 (- *screen-h* 28) 1 (list 0.85 0.9 0.95)))
  (dotimes (k 8)
    (draw-rect (+ 8 (* k 9)) (- *screen-h* 34) 6 6
               (if (< k *ammo*)
                   (list 0.95 0.8 0.4)
                   (list 0.25 0.28 0.35))))
  (if (> *reload-t* 0.0)
      (draw-text "ПЕРЕЗАРЯДКА..." 8 (- *screen-h* 46) 1 (list 0.95 0.8 0.4))
      #f)
  (draw-text (string-append "ОПЕРАЦИЯ ОАЗИС  ВОЛНА " (number->string *wave*)
                            "  ЛИС " (number->string *wave-left*)
                            "  УБИТО " (number->string *kills*))
             8 5 1 (list 1 1 1))
  (draw-text (string-append "W/S ход  A/D поворот  F огонь  FPS "
                            (number->string *fps-last-val*))
             8 13 1 (list 0.65 0.75 0.9))
  (if (string=? *state* "intro")
      (begin
        (draw-rect 0 (/ *screen-h* 3) *screen-w* 76 (list 0.05 0.07 0.11))
        (draw-text "ОПЕРАЦИЯ ОАЗИС" 118 (+ 8 (/ *screen-h* 3)) 1 (list 1 0.85 0.45))
        (draw-text "лисы прорываются к воде — удержи оазис" 66 (+ 26 (/ *screen-h* 3)) 1 (list 0.85 0.9 0.95))
        (draw-text "W/S A/D — двигаться, F — огонь. Начать: F" 88 (+ 44 (/ *screen-h* 3)) 1 (list 0.6 0.9 0.6)))
      #f)
  (if (string=? *state* "dead")
      (begin
        (draw-rect 0 (/ *screen-h* 3) *screen-w* 76 (list 0.12 0.04 0.05))
        (draw-text "ВЫ ПОГИБЛИ" 136 (+ 8 (/ *screen-h* 3)) 1 (list 1 0.4 0.35))
        (draw-text (string-append "волн: " (number->string (- *wave* 1))
                                  "  лис: " (number->string *kills*))
                   96 (+ 26 (/ *screen-h* 3)) 1 (list 0.9 0.85 0.8))
        (draw-text "R — начать заново" 116 (+ 44 (/ *screen-h* 3)) 1 (list 0.95 0.9 0.6)))
      #f))

;; инициализация на верхнем уровне (движок вызывает update/draw сам)
(set! *parts-pool* (part-new))
(set! *fox-model* (gltf-load-skin "../models/fox.gltf"))
(audio-init!)

(define (draw)
  (let* ((wh (window-size)))
    (set! *screen-w* (car wh))
    (set! *screen-h* (cadr wh)))
  ;; небо-градиент 12 полосами: 2D-слой сбрасывается ПЕРВЫМ 3D-вызовом
  ;; (всегда под геометрией), дыр не даёт в принципе
  (let ((band (/ *screen-h* 9.0)))
    (define (sky-band i y)
      (if (>= i 9)
          #f
          (let ((k (/ i 8.0)))
            (draw-rect 0 y *screen-w* (+ band 0.6)
                       (list (- 0.62 (* 0.34 k))
                             (- 0.72 (* 0.24 k))
                             (- 0.88 (* 0.14 k))))
            (sky-band (+ i 1) (+ y band)))))
    (sky-band 0 0))
  (let* ((t *game-t*)
         (eye-y (+ (th *px* *pz*) *eye-h* (* 0.035 (sin *bob*))))
         (shake-x (* 0.022 *shake* (sin (* t 47.0))))
         (shake-y (* 0.022 *shake* (cos (* t 41.0))))
         (eye (list (+ *px* shake-x) (+ eye-y shake-y) *pz*))
         (dead-drop (if (string=? *state* "dead") (* -0.9 (min 1.0 (- *game-t* *dead-t* 0.1))) 0.0))
         (eye2 (list (car eye) (+ (cadr eye) dead-drop) (caddr eye)))
         (target (list (+ *px* (* 10 (sin *yaw*)))
                       (+ (cadr eye2) -1.0)
                       (+ *pz* (* 10 (- 0 (cos *yaw*))))))
         (mvp (camera-mvp eye2 target 0.95))
         (wpn-mvp (mat-perspective 0.85 (/ *screen-w* *screen-h*) 0.05 10.0)))
    (gpu3d-clear 0.72 0.82 0.90)
    (gpu3d-view (car eye2) (cadr eye2) (caddr eye2))
    (draw-scene mvp t)
    (if (string=? *state* "dead")
        #f
        (weapon-draw wpn-mvp))
    (gpu3d-post (+ 1.06 (* 0.35 *flash*))
                0.55
                (+ 0.32 (* 0.30 *hitpulse*))
                0.035)
    (draw-hud)
    (gpu-present)))
