;; oasis.lisp — «ОПЕРАЦИЯ ОАЗИС» (этапы 22–23): играбельный FPS на движке.
;; Оазис в пустыне; волны лис (скиннед модель Fox из сети, CC0) идут к воде,
;; игрок отстреливается из вью-модели автомата. Весь геймплей — Lisp.
;;
;; Управление: W/S — вперёд/назад, A/D — поворот, Shift — бег,
;;             Space — огонь, R — рестарт после гибели.
;;
;; Замечание по диалекту: atan нет — матрица поворота лисы строится прямо
;; из нормированного направления (sin/cos сразу в строках матрицы).

;; ——— параметры мира ———
(define *world-r* 44.0)
(define *fox-scale* 0.026)
(define *fox-bind-y* 17.815)
(define *eye-h* 1.62)

(define (sphere-mesh nring nseg)
  (let ((pos '()) (idx '()) (vi 0))
    (dotimes (i (+ nring 1))
      (dotimes (j nseg)
        (let* ((ph (* 3.14159 (/ i nring)))
               (th (* 6.28318 (/ j nseg)))
               (y (cos ph)))
          (set! pos (append pos (list (* (sin ph) (cos th)) y (* (sin ph) (sin th))))))))
    (define (vi2 i j) (+ (* i nseg) (mod j nseg)))
    (dotimes (i nring)
      (dotimes (j nseg)
        (set! idx (append idx (list (vi2 i j) (vi2 i (+ j 1)) (vi2 (+ i 1) j)
                                    (vi2 (+ i 1) j) (vi2 i (+ j 1)) (vi2 (+ i 1) (+ j 1)))))))
    (list (f32-from-list pos) (f32-from-list idx))))

(define (hash2 x y)
  (abs (sin (+ (* x 12.9898) (* y 78.233)))))

(define (th x z)
  (let ((base (+ (* 0.85 (sin (+ (* x 0.13) 1.1)) (cos (* z 0.11)))
                 (* 0.55 (sin (+ (* x 0.055) (* z 0.075) 2.2)))
                 (* 0.22 (sin (+ (* x 0.31) (* z 0.27)))))))
    (+ (* 0.35 base)
       (- 0.25 (/ 2.6 (+ 1.0 (/ (+ (* x x) (* z z)) 30.0)))))))

;; ——— пески ———
(define *ter-n* 34)
(define (terrain-build)
  (let ((pos '()) (vc '()) (idx '()) (vi 0))
    (define (col-at x z h)
      (let* ((k (max 0.0 (min 1.0 (/ (+ h 2.0) 4.0))))
             (n (hash2 x z)))
        (list (min 1.0 (* (+ (* 0.86 (- 1 k)) (* 0.55 k)) (+ 0.92 (* 0.16 n))))
              (min 1.0 (* (+ (* 0.76 (- 1 k)) (* 0.52 k)) (+ 0.92 (* 0.16 n))))
              (min 1.0 (* (+ (* 0.55 (- 1 k)) (* 0.38 k)) (+ 0.92 (* 0.16 n)))))))
    (define (go j)
      (if (>= j *ter-n*)
          #f
          (let ((z (- (* 2.0 *world-r* (/ j (- *ter-n* 1))) *world-r*)))
            (dotimes (i *ter-n*)
              (let* ((x (- (* 2.0 *world-r* (/ i (- *ter-n* 1))) *world-r*))
                     (h (th x z))
                     (c (col-at x z h)))
                (set! pos (append pos (list x h z)))
                (set! vc (append vc (list (car c) (cadr c) (caddr c) 1.0)))
                (if (and (< i (- *ter-n* 1)) (< j (- *ter-n* 1)))
                    (let ((a vi) (b (+ vi 1)) (c2 (+ vi *ter-n*)) (d (+ vi *ter-n* 1)))
                      (set! idx (append idx (list a c2 b  b c2 d))))
                    #f)
                (set! vi (+ vi 1))))
            (go (+ j 1)))))
    (go 0)
    (list (f32-from-list pos) (f32-from-list vc) (f32-from-list idx))))
(define *ter* (terrain-build))
(define *ter-uv* (make-f32vec (* (* *ter-n* *ter-n*) 2) 0.0))

;; ——— вода вокруг оазиса ———
